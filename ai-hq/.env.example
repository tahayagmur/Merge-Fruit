# AI HQ — environment template. Contains NO real values.
#
# Development: copy to .env.local and fill in.
# Production:  set the same variables in your hosting provider's encrypted
#              environment settings (e.g. Vercel → Settings → Environment Variables).
# Never commit .env.local or any file with real keys.

# ---------------------------------------------------------------------------
# Runtime (required)
# ---------------------------------------------------------------------------

# development | staging | production. Required for production builds.
APP_ENV=development

# URL of the Supabase project for THIS environment.
# Use separate Supabase projects for development and production.
#   Hosted: Supabase dashboard → Project Settings → Data API
#   Local:  printed by `npm run db:start` (http://127.0.0.1:54321)
SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy anon key.
# NEVER put the secret / service_role key here — the app refuses to start with it.
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated emails allowed to use AI HQ.
# Required when APP_ENV=production; optional (empty = any account) otherwise.
AI_HQ_ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Development seed only (`npm run db:seed:dev`). Do NOT set in production.
# ---------------------------------------------------------------------------

# Secret key (sb_secret_...) or legacy service_role key of the DEVELOPMENT project.
# Used only by the seed script; the application never reads it.
SUPABASE_SECRET_KEY=

# Only for seeding a hosted (non-local) development project: its project ref,
# e.g. the "abcd1234..." part of https://abcd1234....supabase.co
DEV_SUPABASE_PROJECT_REF=

# Development login created by the seed script. If the password is empty a
# random one is generated and printed once.
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Integrations — NOT USED YET. Leave empty.
#
# Phase 2 ships no connectors: AI HQ contacts no external service, whatever is
# set here. The Integrations page only reports whether each variable EXISTS
# (never its value) so you can prepare a server. Non-secret settings (URLs,
# ids, modes) are entered on the Integrations page, never here.
# Secrets are read on the server only; never prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# n8n Cloud (Phase 3). AI HQ will only use workflows that already exist in your
# account; it never creates or edits workflows.
N8N_API_KEY=
N8N_WEBHOOK_SIGNING_SECRET=

# Model providers for AI Agent Hub (Phase 4).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Signed inbound webhooks (Phase 3).
WEBHOOK_SIGNING_SECRET=

# Store consoles for Game Studio (Phase 5). Base64-encoded file contents.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APP_STORE_CONNECT_PRIVATE_KEY=

# Read-only payment data for SaaS & Business (Phase 6). Use a RESTRICTED key.
STRIPE_RESTRICTED_KEY=
